# =============================================================================
# P&K Business Manager — backend
# Copier ce fichier vers .env (jamais de .env réel dans Git) :
#   cp .env.example .env
# Les valeurs ci-dessous sont des valeurs de DÉVELOPPEMENT local uniquement.
# =============================================================================

# --- Environnement ---
# development | test | production
NODE_ENV=development
PORT=3000

# --- Base de données PostgreSQL ---
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=pk_manager
DB_PASSWORD=pk_manager_dev
DB_NAME=pk_manager
# true = TypeORM crée/ajuste le schéma tout seul (développement jetable).
# false = schéma géré par les migrations (valeur attendue hors développement).
DB_SYNC=false
DB_LOGGING=false

# --- Jetons ---
# Secret HMAC de l'access token : 32 caractères minimum.
# Générer une valeur : openssl rand -base64 48
JWT_ACCESS_SECRET=dev-only-secret-change-me-please-32-chars-minimum
# Durée de vie de l'access token, en secondes (15 minutes par contrat d'API).
JWT_ACCESS_TTL_SECONDS=900
# Durée de vie absolue d'une session (et de son refresh token), en jours.
REFRESH_TOKEN_TTL_DAYS=30

# --- Cookie de refresh token (clients « web ») ---
# true force l'attribut Secure. Par défaut : Secure si NODE_ENV=production.
# Mettre false sur un poste local en HTTP si NODE_ENV=production est utilisé.
COOKIE_SECURE=

# --- HTTP / CORS ---
# Origines autorisées, séparées par des virgules (ici : Vite et Expo web).
CORS_ORIGINS=http://localhost:5173,http://localhost:8081

# --- Limitation de débit (anti force brute) ---
# Quota GLOBAL par IP et par fenêtre (toutes routes confondues). Les quotas
# spécifiques des routes /api/auth (login : 5/min, refresh : 30/min) sont des
# constantes du code, documentées dans docs/decisions.md.
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120

# --- Compte administrateur initial (`npm run db:seed`) ---
# Laissez le mot de passe vide pour ne rien créer. Mot de passe : 8 caractères
# minimum, au moins une lettre et un chiffre.
SEED_ADMIN_EMAIL=admin@pk.local
SEED_ADMIN_PASSWORD=Admin1234
SEED_ADMIN_FULLNAME=Administrateur P&K
